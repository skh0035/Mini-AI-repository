digraph G {
  rankdir=LR; bgcolor="white"; pad=0.3; nodesep=0.3; ranksep=0.45; newrank=true;
  node [fontname="Helvetica", fontsize=13, shape=box, style="rounded,filled", penwidth=1.5];
  edge [color="#444444", penwidth=1.4];
  label=<<b>Figure 3.1  Two ways to give a computer knowledge</b>>; labelloc=t; fontname="Helvetica"; fontsize=16; fontcolor="#1f3a5f";

  subgraph cluster_a { label="A. Symbolic AI (top-down): people write the rules"; fontname="Helvetica-Bold"; fontsize=14; color="#2e7d32"; style="rounded";
    a_rules [label="Rules\n(written by people)", fillcolor="#e6f2e6", color="#2e7d32"];
    a_data [label="New email", fillcolor="#e8eef7", color="#1f3a5f"];
    a_prog [label="Program applies\nthe rules", fillcolor="#fff4d6", color="#b07a1e"];
    a_out [label="Answer\n(spam / not spam)", fillcolor="#1f3a5f", fontcolor="white", color="#1f3a5f"];
    a_rules -> a_prog; a_data -> a_prog; a_prog -> a_out;
  }
  subgraph cluster_b { label="B. Machine learning (bottom-up): the computer learns the 'rules' from examples"; fontname="Helvetica-Bold"; fontsize=14; color="#b03a2e"; style="rounded";
    b_data [label="Many example emails", fillcolor="#e8eef7", color="#1f3a5f"];
    b_ans [label="Their correct labels\n(spam / not spam)", fillcolor="#e8eef7", color="#1f3a5f"];
    b_train [label="Training\nfinds patterns", fillcolor="#fff4d6", color="#b07a1e"];
    b_model [label="Model\n(learned, not\nwritten by people)", fillcolor="#fbe3e0", color="#b03a2e"];
    b_new [label="New email", fillcolor="#e8eef7", color="#1f3a5f"];
    b_out [label="Answer\n(spam / not spam)", fillcolor="#1f3a5f", fontcolor="white", color="#1f3a5f"];
    b_data -> b_train; b_ans -> b_train; b_train -> b_model; b_model -> b_out; b_new -> b_out [style=invis];
    b_new -> b_model;
  }
  a_rules -> b_data [style=invis];
}
