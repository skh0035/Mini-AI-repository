digraph G {
  rankdir=LR; bgcolor="white"; pad=0.3; nodesep=0.35; ranksep=0.6;
  node [fontname="Helvetica", fontsize=13, penwidth=1.6];
  edge [fontname="Helvetica", fontsize=12, color="#444444", penwidth=1.4];
  label=<<b>Figure 2.2  Forward chaining: facts → rules → new facts</b><br/><font point-size="12">Blue = starting facts    Yellow = rule that fires    Green = fact added by the engine</font>>; labelloc=t; fontname="Helvetica"; fontsize=16; fontcolor="#1f3a5f";

  f1 [label="has feathers", shape=box, style="rounded,filled", fillcolor="#e8eef7", color="#1f3a5f"];
  f2 [label="cannot fly", shape=box, style="rounded,filled", fillcolor="#e8eef7", color="#1f3a5f"];
  f3 [label="swims", shape=box, style="rounded,filled", fillcolor="#e8eef7", color="#1f3a5f"];
  r1 [label="R1\n(cycle 1)", shape=diamond, style=filled, fillcolor="#fff4d6", color="#b07a1e"];
  bird [label="is a bird\n(new fact)", shape=box, style="rounded,filled", fillcolor="#e6f2e6", color="#2e7d32"];
  r3 [label="R3\n(cycle 2)", shape=diamond, style=filled, fillcolor="#fff4d6", color="#b07a1e"];
  peng [label="is a penguin\n(conclusion)", shape=box, style="rounded,filled,bold", fillcolor="#1f3a5f", fontcolor="white", color="#1f3a5f"];

  f1 -> r1; r1 -> bird; bird -> r3; f2 -> r3; f3 -> r3; r3 -> peng;
  {rank=same; f1; f2; f3;}
}
